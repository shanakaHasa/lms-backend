# Copy to .env. Never commit .env.
# Every value here is a LOCAL DEVELOPMENT default. Settings refuses to boot in
# prod with any of them still in place -- see app/core/config.py.

APP_ENV=local                 # local | dev | prod
LOG_LEVEL=INFO
API_PORT=8000

# ── Database ───────────────────────────────────────────────────────────────
# There is no local Postgres. This points at the Aurora cluster that
# ../platform provisions:
#   terraform -chdir=../platform/infra output -raw database_url_lms
DATABASE_URL=postgresql+asyncpg://teachassist:CHANGE_ME@CHANGE_ME.rds.amazonaws.com:5432/lmsdb
TEST_DATABASE_URL=postgresql+asyncpg://teachassist:CHANGE_ME@CHANGE_ME.rds.amazonaws.com:5432/lmsdb_test
DB_SSL_MODE=verify-full        # disable | require | verify-full
DB_CA_BUNDLE_PATH=rds-ca.pem
#   curl -o rds-ca.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

# ── Auth ───────────────────────────────────────────────────────────────────
# auth-backend is still being built, so a fixed local principal stands in.
# MUST be false in prod -- this service holds student records.
AUTH_DISABLED=true
AUTH_ISSUER=http://localhost:8001
AUTH_AUDIENCE=teachassist-api
JWKS_CACHE_TTL_SECONDS=300
# Without these, a token with a random `kid` makes this service hammer auth's
# JWKS endpoint -- a DoS amplifier pointed at our own identity provider.
JWKS_UNKNOWN_KID_COOLDOWN_SECONDS=30
JWKS_NEGATIVE_CACHE_SECONDS=60

# ── Storage and queue (local now, AWS later, same interfaces) ─────────────
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=./data/materials
QUEUE_BACKEND=postgres         # postgres | sqs
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
QUEUE_MAX_ATTEMPTS=3

# ── LLM (step B6) ──────────────────────────────────────────────────────────
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_CHEAP_MODEL=

# ── Embeddings and vector store (step B5) ──────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
PINECONE_API_KEY=
# The index name carries model and dimension: a Pinecone index's dimension is
# fixed at creation, so changing embedding provider needs a NEW index and a
# full reindex -- not a config change.
PINECONE_INDEX=teachassist-local-te3s-1536
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Retrieval tuning ───────────────────────────────────────────────────────
RETRIEVAL_TOP_K=40             # candidates per retriever before fusion
RETRIEVAL_FINAL_K=8            # passages handed to the model
CHUNK_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RERANK_ENABLED=true

# ── Observability ──────────────────────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_MASK_PII=true

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
